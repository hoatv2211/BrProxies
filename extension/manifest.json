{
  "manifest_version": 3,
  "minimum_chrome_version": "102",
  "name": "BrProxies Bridge",
  "version": "0.3.0",
  "description": "Export and convert Codex account JSON for 9Router/Cockpit, plus control BrProxies ProxyPool.",
  "permissions": ["proxy", "storage"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://chatgpt.com/*",
    "https://www.chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://www.chat.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "BrProxies Bridge"
  }
}
